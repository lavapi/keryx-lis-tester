{
  "name": "keryx-lis-tester",
  "version": "0.1.0",
  "description": "Mock LIS (HELD / RFC 5985) server for exercising Call Handling location parsing.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test",
    "scenarios": "tsx src/scripts/listScenarios.ts",
    "postman": "tsx src/scripts/generatePostman.ts"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "pino-pretty": "^11.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
